#!/bin/bash
out=""; filt=""; snap=0; cnt=0; ifc=""
while [ $# -gt 0 ]; do case "$1" in -w) out="$2"; shift ;; -s) snap="$2"; shift ;; -c) cnt="$2"; shift ;; -i) ifc="$2"; shift ;; -nn) ;; *) filt="$filt $1" ;; esac; shift; done
case "$filt" in *"subtype beacon"*)
  bss=$(printf '%s' "$filt" | sed -n 's/.*addr2 \([0-9a-fA-F:]*\).*/\1/p' | tr -d ':' | tr 'A-F' 'a-f')
  # HARNESS_NO_BEACON=1: the target never beacons for us -- write nothing, so capture_beacon fails and the badge is ?
  [ -n "${HARNESS_NO_BEACON:-}" ] && { printf 'TCPDUMP beacon suppressed %s\n' "$bss" >> "${HARNESS_LOG:-/tmp/cs_harness.log}"; exit 0; }
  le32h() { printf '%02x%02x%02x%02x' $(( $1 & 255 )) $(( ($1 >> 8) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 24) & 255 )); }
  rsn="0100000fac040100000fac040100000fac020c00"
  frame="000008000000000080000000ffffffffffff${bss}${bss}0000000000000000000064001104000463616d3130$(printf %02x $(( ${#rsn} / 2 )))$rsn"
  flen=$(( ${#frame} / 2 )); hex="d4c3b2a1020004000000000000000000$(le32h 65535)$(le32h 127)$(le32h 0)$(le32h 0)$(le32h $flen)$(le32h $flen)$frame"
  for ((i = 0; i < ${#hex}; i += 2)); do printf "\\x${hex:$i:2}"; done > "$out"
  printf 'TCPDUMP beacon %s -> %s\n' "$bss" "$out" >> "${HARNESS_LOG:-/tmp/cs_harness.log}"; exit 0 ;;
esac
mem=0
if [ "${cnt:-0}" -gt 0 ]; then      # only capture_bss and assoc_capture pass -c here; the Watch captures never do
  case "$filt" in
    *"(wlan addr2"*) mem=3 ;;       # the inverse lookup (assoc_capture): ONE client's MAC, addr2 first
    *"(wlan addr1"*) mem=1 ;;       # the membership capture (capture_bss), the OR form
    *"type data and wlan addr2"*) mem=4 ;;   # the inverse lookup's uplink-only fallback
    *"type data"*)   mem=2 ;;       # the membership capture's uplink-only fallback
  esac
fi
if [ "$mem" = 3 ] || [ "$mem" = 4 ]; then
  # The inverse lookup: frames to or from ONE client, from which CLI_AWK's pairs mode names its
  # BSSID. Who is associated to whom is fix/cli.json's ap_mac column -- the stand-in for what no
  # shipped firmware supplies -- so the fixture stays the single source of truth, and a client with
  # no ap_mac there is heard talking to nobody. The radio has to be where the client is: parked on
  # another channel it hears nothing (ec:71:db:00:00:11 and :12 are last heard on 2437 MHz while
  # their AP is on channel 36, the "last-heard frequency is not the association channel" case that
  # is already in the fixtures), and while it is hopping (/tmp/cs_harness_hop exists) every channel
  # is visited, so the client is heard.
  L="${HARNESS_LOG:-/tmp/cs_harness.log}"
  sta=$(printf '%s' "$filt" | sed -n 's/.*addr2 \([0-9a-fA-F:]*\).*/\1/p' | tr 'A-F' 'a-f')
  # the interface is logged: a capture with no -i listens on whatever libpcap picks, not on the monitor radio
  printf 'TCPDUMP assoc %s if=%s snap=%s count=%s or=%s\n' "$sta" "$ifc" "$snap" "$cnt" "$mem" >> "$L"
  # HARNESS_NO_ARM=1: tcpdump refuses the filter outright -> NO_CAPTURE
  [ -n "${HARNESS_NO_ARM:-}" ] && { printf 'TCPDUMP assoc refused to arm\n' >> "$L"; exit 1; }
  # HARNESS_NO_OR=1: only the OR form is refused, so the uplink-only fallback is exercised
  [ -n "${HARNESS_NO_OR:-}" ] && [ "$mem" = 3 ] && { printf 'TCPDUMP assoc OR form refused\n' >> "$L"; exit 1; }
  le32h() { printf '%02x%02x%02x%02x' $(( $1 & 255 )) $(( ($1 >> 8) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 24) & 255 )); }
  hex="d4c3b2a1020004000000000000000000$(le32h "${snap:-128}")$(le32h 127)"
  ap=$(jq -r --arg m "${sta^^}" '.[] | select(.mac == $m) | (.ap_mac // "-")' "${HARNESS_FIX}/cli.json" 2>/dev/null | head -1)
  apch=$(jq -r --arg m "$ap" '.[] | select(.mac == $m) | .beacon[0].channel' "${HARNESS_FIX}/aps.json" 2>/dev/null | head -1)
  heard=0
  if [ -n "$ap" ] && [ "$ap" != - ]; then
    if [ -e /tmp/cs_harness_hop ]; then heard=1
    elif [ "$(cat /tmp/cs_harness_chan 2>/dev/null)" = "$apch" ]; then heard=1; fi
  fi
  if [ "$heard" = 1 ]; then
    rt="000012000000000000000000000000000000"          # radiotap it_len 18, as the membership arm below writes
    s12=$(printf '%s' "$sta" | tr -d ':'); b12=$(printf '%s' "$ap" | tr -d ':' | tr 'A-F' 'a-f')
    blist="$b12 $b12 $b12"
    # HARNESS_ASSOC_TWO=1: the client is heard talking to a second BSSID as often -> AMBIGUOUS
    [ -n "${HARNESS_ASSOC_TWO:-}" ] && blist="$blist b0a7b9000001 b0a7b9000001 b0a7b9000001"
    for b in $blist; do
      fr="${rt}08010000${b}${s12}${b}0000"                           # ToDS: addr1 the BSSID, addr2 the client
      # HARNESS_ASSOC_DOWN=1: only the AP is heard, sending TO the client (FromDS: addr1 the client, addr2 the
      # BSSID) -- what is on the air after the client has left and before the AP gives up on it -> NO_UPLINK
      [ -n "${HARNESS_ASSOC_DOWN:-}" ] && fr="${rt}08020000${s12}${b}${b}0000"
      fl=$(( ${#fr} / 2 ))
      hex+="$(le32h 0)$(le32h 0)$(le32h $fl)$(le32h $fl)$fr"
    done
  fi
  for ((i = 0; i < ${#hex}; i += 2)); do printf "\\x${hex:$i:2}"; done > "$out"
  printf 'TCPDUMP assoc %s -> %s heard=%s\n' "$sta" "$out" "$heard" >> "$L"; exit 0
fi
if [ "$mem" != 0 ]; then
  L="${HARNESS_LOG:-/tmp/cs_harness.log}"
  bss=$(printf '%s' "$filt" | sed -n 's/.*addr1 \([0-9a-fA-F:]*\).*/\1/p' | tr -d ':' | tr 'A-F' 'a-f')
  printf 'TCPDUMP members %s snap=%s count=%s or=%s\n' "$bss" "$snap" "$cnt" "$mem" >> "$L"
  # HARNESS_NO_ARM=1: tcpdump refuses the filter outright -> capture_bss fails -> NO_CAPTURE
  [ -n "${HARNESS_NO_ARM:-}" ] && { printf 'TCPDUMP members refused to arm\n' >> "$L"; exit 1; }
  # HARNESS_BAD_PCAP=1: a file exists but is not a pcap -> bss_clients rc 1 -> NO_CAPTURE
  [ -n "${HARNESS_BAD_PCAP:-}" ] && { printf 'not a pcap at all' > "$out"; printf 'TCPDUMP members wrote garbage\n' >> "$L"; exit 0; }
  # HARNESS_NO_OR=1: only the OR form is refused, so the uplink-only fallback is exercised
  [ -n "${HARNESS_NO_OR:-}" ] && [ "$mem" = 1 ] && { printf 'TCPDUMP members OR form refused\n' >> "$L"; exit 1; }
  le32h() { printf '%02x%02x%02x%02x' $(( $1 & 255 )) $(( ($1 >> 8) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 24) & 255 )); }
  hsnap="${snap:-128}"
  [ -n "${HARNESS_SHORT_SNAP:-}" ] && hsnap=20      # as tcpdump -s 20 would record it
  # slots: magic, version, thiszone+sigfigs, SNAPLEN, LINKTYPE. 127 = radiotap, as the beacon
  # arm above writes. An earlier revision put the snap in the linktype slot, so the header snaplen
  # stayed 65535 and a truncated record could never be told from a short frame.
  hex="d4c3b2a1020004000000000000000000$(le32h "$hsnap")$(le32h 127)"
  # HARNESS_NO_MEMBERS=1: armed and heard nobody. tcpdump leaves exactly the 24-byte global header,
  # which is the artifact that tells NO_CLIENTS apart from NO_CAPTURE.
  # Only the Reolink NVR AP has clients in these fixtures; every other BSSID must hear nobody, or
  # the stub would invent members for the setup AP that exists precisely to have none.
  [ "$bss" != ec71db000010 ] && HARNESS_NO_MEMBERS=1
  if [ -z "${HARNESS_NO_MEMBERS:-}" ]; then
    rt="000012000000000000000000000000000000"          # radiotap it_len 18, not a multiple of 4
    # HARNESS_ALIEN_MEMBERS=1: stations Recon has no row for -> heard, but none measurable
    mlist="ec71db000011 ec71db000012"
    [ -n "${HARNESS_ALIEN_MEMBERS:-}" ] && mlist="ec71dbaa0001 ec71dbaa0002"
    for c in $mlist; do
      for _ in 1 2; do                                  # twice each: bss_clients needs >= 2 sightings
        fr="${rt}08010000${bss}${c}${bss}0000"          # ToDS: addr1 BSSID, addr2 client
        fl=$(( ${#fr} / 2 )); il=$fl
        # HARNESS_SHORT_SNAP=1: records arrive but are cut below rt+16 -> SNAP_SHORT, not NO_CLIENTS
        [ -n "${HARNESS_SHORT_SNAP:-}" ] && { fr="${fr:0:40}"; il=20; }
        hex+="$(le32h 0)$(le32h 0)$(le32h $il)$(le32h $fl)$fr"
      done
    done
  fi
  for ((i = 0; i < ${#hex}; i += 2)); do printf "\\x${hex:$i:2}"; done > "$out"
  printf 'TCPDUMP members %s -> %s\n' "$bss" "$out" >> "$L"; exit 0
fi
printf 'TCPDUMP %s [%s]\n' "$out" "$filt" >> "${HARNESS_LOG:-/tmp/cs_harness.log}"
t0=$(date +%s)
le32() { printf "\\x$(printf %02x $(( $1 & 255 )))\\x$(printf %02x $(( ($1 >> 8) & 255 )))\\x$(printf %02x $(( ($1 >> 16) & 255 )))\\x$(printf %02x $(( ($1 >> 24) & 255 )))"; }
write_pcap() {
  secs=$(( $(date +%s) - t0 )); (( secs < 1 )) && secs=1
  case "$filt" in *"not wlan addr2"*) per=1; ol=1400 ;; *addr2*) per=$(cat /tmp/cs_harness_pps 2>/dev/null || echo ${HARNESS_UP_PPS:-14}); ol=1400 ;; *) per=${HARNESS_DN_PPS:-2}; ol=200 ;; esac
  { le32 2712847316; printf '\x02\x00\x04\x00'; le32 0; le32 0; le32 32; le32 127
    for ((s = 0; s < secs; s++)); do for ((i = 0; i < per; i++)); do le32 $((t0 + s)); le32 $((i * 1000)); le32 32; le32 "$ol"; printf '%032d' 0 | tr 0 '\0'; done; done; } > "$out"
  echo "0 packets dropped by kernel" >&2
  exit 0
}
trap write_pcap TERM INT
while :; do sleep 0.2; done
