#!/bin/bash
case "$1 $2" in
  "RECON APS") n=$(cat /tmp/cs_harness_cycle 2>/dev/null || echo 0); f="${HARNESS_FIX}/aps_$n.json"; [ -f "$f" ] || f="${HARNESS_FIX}/aps.json"; cat "$f"; echo $((n+1)) > /tmp/cs_harness_cycle ;;
  "RECON CLIENTS") [ -n "${HARNESS_NO_CLIENTS:-}" ] && { echo "Unknown recon command"; exit 255; }   # 1.1.3 has no CLIENTS verb
                   n=$(cat /tmp/cs_harness_cycle 2>/dev/null || echo 1); f="${HARNESS_FIX}/cli_$((n-1)).json"; [ -f "$f" ] || f="${HARNESS_FIX}/cli.json"; cat "$f" ;;
  "RECON DEVICES") printf 'RECON DEVICES\n' >> "${HARNESS_LOG:-/tmp/cs_harness.log}"; cat "${HARNESS_FIX}/devices.json" ;;   # every device, real 1.1.3 shape, no association
  "MONITOR "*) printf 'MONITOR %s\n' "$*" >> "${HARNESS_LOG:-/tmp/cs_harness.log}"; i=0; while :; do echo $(( -70 + (i % 10) )); i=$((i+1)); sleep 0.2; done ;;
  "EXAMINE CANCEL") printf 'EXAMINE CANCEL\n' >> "${HARNESS_LOG:-/tmp/cs_harness.log}" ;;
esac
